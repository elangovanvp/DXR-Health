# ==============================================================================
# DXR Health Backend Service - Environment Variables Template
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dxr_health
SPRING_DATASOURCE_USERNAME=dxr_user
SPRING_DATASOURCE_PASSWORD=dxr_secure_password_2026
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# MinIO / S3 Object Storage Configuration
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ACCESS_KEY=dxr_minio_admin
STORAGE_S3_SECRET_KEY=dxr_minio_secret_key_2026
STORAGE_S3_BUCKET=dxr-xray-images
STORAGE_LOCAL_FALLBACK=true

# AI Triage Adapter Configuration (mock | remote | rule-based)
AI_ADAPTER_TYPE=mock
AI_REMOTE_INFERENCE_URL=http://localhost:8000/v1/infer

# File Ingestion Constraints
INGESTION_MAX_FILE_SIZE_MB=50
